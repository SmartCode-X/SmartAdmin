# docker compose 的环境变量样板。复制成 .env（同目录，已被 .gitignore 忽略）再改值。
#
# 前三个没有默认值：不给就起不来。docker-compose.yml 里这三项用的是 `${VAR:?提示}` 语法，
# 变量未设时 compose 直接拒绝启动并打印提示，而不是回落到某个内置默认值——
# 签名密钥、数据库密码、超管密码这类值一旦写死进 compose 默认值，任何人 `docker compose up`
# 起的都是同一套人尽皆知的凭据。拿不到这三个值的部署，本来就不该启动。
#
#   cp .env.example .env
#   # Linux/macOS 生成一个够长的随机密钥：
#   openssl rand -base64 48

# JWT 签名密钥。≥32 字节随机串。换掉它 = 所有已签发的令牌立即失效（全员重新登录）。
SMART_JWT_SECRET=

# MySQL root 密码。首次 `up` 时写进数据卷，之后改这里不会改库里的密码——
# 要改先 `docker compose down -v`（会删数据）。
SMART_DB_PASSWORD=

# 超级管理员初始密码。只在空库首启建号那一次生效，之后改密码走个人中心。
SMART_ADMIN_PASSWORD=

# ── 以下都有默认值，按需覆盖 ────────────────────────────────────────────────
# 时区。定时任务按服务器本地时间调度，所有副本必须一致。
# SMART_TZ=Asia/Shanghai

# 前端（Caddy）对外端口。容器内固定 8080——Caddy 以非 root 跑，绑不了 80。
# SMART_WEB_PORT=8080

# 后端直连端口，只绑回环。生产建议整条去掉，只留反向代理入口
# （能直连它的人可以伪造 X-Forwarded-For，绕开按 IP 的限流）。
# SMART_API_PORT=8081
