<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- 元包:一引全栈(Core + SqlSugar + Services + AspNetCore)。 -->
    <PackageReference Include="SmartAdmin" Version="SMART_PKG_VERSION" />
  </ItemGroup>

  <!-- Tests/ 是独立的测试工程,不能被本工程的默认通配收进来,否则测试代码会编进 host 产物。 -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
  </ItemGroup>

</Project>
